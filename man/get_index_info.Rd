\name{get_index_info}
\alias{get_index_info}
\title{Extrai informações de auditoria do índice}
\usage{
get_index_info(index_result)
}
\arguments{
\item{index_result}{Resultado produzido por \code{IBrCRMindex()}.}
}
\value{
Lista com variáveis selecionadas, pesos, estado da CFA e número de variáveis.
}
\description{
Extrai os atributos de auditoria anexados ao resultado do índice.
}
